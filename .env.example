# Banco de dados
DATABASE_URL=sqlite+aiosqlite:///./data/swimtimer.db

# Backup continuo (intervalo em minutos entre backups de eventos ativos)
# BACKUP_INTERVAL_MIN=5
# Espelho opcional (pendrive). Precisa estar visivel dentro do container;
# veja o exemplo comentado em docker-compose.yml.
# BACKUP_MIRROR_DIR=/app/data/mirror
# Diario NDJSON por evento (padrao: backend/data/journal)
# JOURNAL_DIR=/app/data/journal

# Hotspot (usado pelo hotspot.sh, não pelo servidor)
# HOTSPOT_SSID=SwimTimer
# HOTSPOT_PASSWORD=swim2025
# HOTSPOT_INTERFACE=wlan0
